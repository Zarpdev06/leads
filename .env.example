# ============================================================================
#  Lead Intelligence / Outreach / CRM  —  environment configuration
#  Copy to .env and fill in. NEVER commit .env
# ============================================================================

# ---------------------------------------------------------------- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.e2b.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://*.e2b.app
DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=en-us

# Encryption key for secrets stored in the DB (AI keys, etc.).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ------------------------------------------------------------- Database -----
# postgres | sqlite   (sqlite is only intended for local test runs)
DB_ENGINE=postgres
POSTGRES_DB=leads
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DATABASE_URL=postgres://leads:leads@db:5432/leads   # alternative to the above
DATABASE_CONN_MAX_AGE=60

# ---------------------------------------------------------------- Redis -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----------------------------------------------------------------- SMTP -----
# These are the ONLY place SMTP credentials come from. Nothing is hardcoded.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL="Your Company <outreach@yourdomain.com>"
DEFAULT_REPLY_TO=replies@yourdomain.com

# ------------------------------------------------- Daily sending limits -----
# Hard ceiling imposed by your SMTP provider.
SMTP_DAILY_LIMIT=100
# Marketing budget: must be strictly <= SMTP_DAILY_LIMIT.
DEFAULT_DAILY_MARKETING_LIMIT=90
# Absolute safety cap. CANNOT be raised from the admin UI.
EMAIL_HARD_DAILY_CAP=90
# Spreading sends through the day (24h local time).
SEND_WINDOW_START=09:30
SEND_WINDOW_END=17:30
SEND_WEEKDAYS=1,2,3,4,5
EMAIL_MIN_SECONDS_BETWEEN_SENDS=20
EMAIL_MAX_ATTEMPTS=3
EMAIL_BATCH_SIZE_PER_RUN=25

# ------------------------------------------------------------ Compliance ----
# Physical address / brand used in the unsubscribe footer (CAN-SPAM).
COMPANY_LEGAL_NAME="Your Company LLC"
COMPANY_POSTAL_ADDRESS="123 Example St, City, State, ZIP, Country"
PUBLIC_BASE_URL=http://localhost
UNSUBSCRIBE_SECRET=change-me-unsubscribe-signing-key

# ------------------------------------------------------------------- AI -----
# providers: rules | openai | anthropic | ollama    ("rules" = offline, no key)
AI_PROVIDER=rules
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=700
AI_ENABLED=1

# ---------------------------------------------------------------- Import ----
IMPORT_CHUNK_SIZE=1000
IMPORT_MAX_FILE_MB=500
IMPORT_MAX_ROWS_PER_JOB=50000000
MEDIA_ROOT=/app/media

# --------------------------------------------------------------- CORS/CSRF --
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# -------------------------------------------------------------- Tracking ----
TRACK_OPENS=1
TRACK_CLICKS=1
# Optional IMAP polling for replies/bounces (leave user/password blank to disable)
IMAP_ENABLED=0
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=1
IMAP_MAILBOX=INBOX

# ---------------------------------------------------------------- Superuser -
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
